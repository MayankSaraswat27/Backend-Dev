<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Blog Posts</h1>
<a href="/posts/new">Create New Post</a>

<ul>
  <% posts.forEach(p => { %>
    <li>
      <a href="/posts/<%= p.id %>"><%= p.title %></a>
    </li>
  <% }) %>
</ul>

</body>
</html>