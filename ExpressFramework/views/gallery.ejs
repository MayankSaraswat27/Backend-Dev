<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Photo Gallery</h1>

<% images.forEach((ele) => { %>
  <img src="<%=ele %>" width="200px" height="200px">
<% }) %>

<br><br>

<%if(page>1){%>
    <a href="/gallery?page=<%= page - 1 %>">Previous</a>
<%}%>

<% for (let i = 1; i <= totalPages; i++) { %>
  <a href="/gallery?page=<%= i %>">
    <%= i %>
  </a>
<% } %>

<%if(page<totalPages){%>
    <a href="/gallery?page=<%= page + 1 %>">Next</a>
<%}%>



</body>
</html>